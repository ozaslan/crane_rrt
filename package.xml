<?xml version="1.0"?>
<package format="3">
  <name>crane_rrt</name>
  <version>1.0.0</version>
  <description>Force-smooth kinodynamic RRT planning and nonlinear 3D gantry crane ROS 2 simulation and benchmark suite (ECC 2027).</description>

  <maintainer email="tozaslan@aybu.edu.tr">Tolga Ozaslan</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>eigen</depend>
  <depend>yaml-cpp</depend>
  <depend>boost</depend>
  <depend>libopencv-dev</depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>python3-tk</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

